{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "3080 Brief Claim Ledger",
  "type": "object",
  "required": ["source", "claims"],
  "properties": {
    "source": {
      "type": "object",
      "required": ["title", "location", "language", "output_language", "output_language_basis", "material_sufficiency"],
      "properties": {
        "title": {"type": "string"},
        "location": {"type": "string"},
        "language": {"type": "string", "minLength": 2},
        "output_language": {"type": "string", "minLength": 2},
        "output_language_basis": {"enum": ["source_primary_language", "explicit_user_request"]},
        "explicit_language_override_evidence": {"type": "string"},
        "material_sufficiency": {
          "type": "object",
          "required": ["status", "handling", "rationale"],
          "properties": {
            "status": {"enum": ["sufficient", "thin", "blocked"]},
            "handling": {"enum": ["proceed", "shorten", "clarify"]},
            "rationale": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        }
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "claim", "priority", "source_location", "board_status"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[0-9]{2,}$"},
          "claim": {"type": "string"},
          "priority": {"enum": ["P0", "P1", "P2"]},
          "kind": {"enum": ["conclusion", "evidence", "logic", "risk", "boundary", "action", "context", "term"]},
          "source_location": {"type": "string"},
          "source_excerpt": {"type": "string"},
          "source_identity": {
            "enum": ["source_fact", "source_author_claim", "source_self_report", "agent_inference", "unknown"]
          },
          "evidence_ceiling": {
            "enum": ["unknown", "reported", "observed", "suggestive", "supported", "demonstrated", "causal"]
          },
          "output_assertion": {
            "enum": ["unknown", "reported", "observed", "suggestive", "supported", "demonstrated", "causal"]
          },
          "protected_relations": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["subject", "predicate", "object", "scope", "time_status", "qualifiers"],
              "properties": {
                "subject": {"type": "string", "minLength": 1},
                "predicate": {"type": "string", "minLength": 1},
                "object": {"type": "string", "minLength": 1},
                "scope": {"type": "string", "minLength": 1},
                "time_status": {"type": "string", "minLength": 1},
                "qualifiers": {"type": "string", "minLength": 1},
                "values": {
                  "type": "array",
                  "items": {"type": "string", "minLength": 1},
                  "uniqueItems": true
                }
              },
              "additionalProperties": false
            }
          },
          "board_status": {"enum": ["covered", "partial", "omitted"]},
          "board_block": {"type": "string"},
          "body_section": {"type": "string"},
          "semantic_direction": {"enum": ["favorable", "unfavorable", "warning", "neutral", "unknown"]},
          "display_values": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          },
          "omission_reason": {"type": "string"},
          "appendix": {"type": "boolean", "default": false},
          "inference": {"type": "boolean", "default": false}
        },
        "allOf": [
          {
            "if": {"properties": {"priority": {"enum": ["P0", "P1"]}}},
            "then": {"required": ["source_identity", "evidence_ceiling", "output_assertion", "protected_relations"]}
          }
        ]
      }
    }
  }
}
