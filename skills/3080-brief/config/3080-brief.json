{
  "version": 16,
  "language_policy": {
    "default_output_basis": "source_primary_language",
    "allowed_override_basis": "explicit_user_request",
    "source_snapshot_verification_required": true,
    "source_language_minimum_script_characters": 60,
    "source_language_dominant_script_share": 0.6,
    "ambiguous_source_action": "clarify",
    "forbidden_inference_bases": [
      "conversation_language",
      "request_language",
      "context_language",
      "user_locale",
      "inferred_preference"
    ]
  },
  "coverage": {
    "minimum_percent": 80,
    "weights": {
      "P0": 3,
      "P1": 2,
      "P2": 1
    },
    "countable_statuses": ["covered", "partial", "omitted"],
    "partial_credit": 0.5,
    "require_visible_tokens": true
  },
  "semantic_colors": {
    "favorable": {
      "body": "green",
      "svg": "#2EA121",
      "svg_tint": "#E8F5E6"
    },
    "unfavorable": {
      "body": "red",
      "svg": "#D83931",
      "svg_tint": "#FDE9E7"
    },
    "warning": {
      "body": "orange",
      "svg": "#DE7802",
      "svg_tint": "#FFF1DE"
    },
    "neutral": {
      "body": "blue",
      "svg": "#1456F0",
      "svg_tint": "#E8F0FF"
    },
    "unknown": {
      "body": "gray",
      "svg": "#646A73",
      "svg_tint": "#EFF0F1"
    }
  },
  "whiteboard_render": {
    "max_viewbox_aspect_ratio": 1.7,
    "body_figure_max_viewbox_aspect_ratio": 4.0
  },
  "theme_policy": {
    "required": true,
    "registry": "assets/themes/beautiful-feishu-themes.json",
    "source_library": "beautiful-feishu-whiteboard",
    "same_theme_for_visual_and_html": true,
    "selection_basis": ["document_type", "audience", "tone", "information_relationship", "density"],
    "default_theme_allowed": false,
    "content_fit_rationale_required": true
  },
  "feishu_render": {
    "structured_builder": "scripts/build_feishu_brief.py",
    "max_body_callouts": 1,
    "figure_caption_required": true,
    "body_visualization_text_threshold": 1600,
    "dense_section_requires_intro": true,
    "consecutive_tables_allowed": false
  },
  "html_render": {
    "offline_required": true,
    "external_runtime_resources_allowed": false,
    "rich_design_plan_required": true,
    "design_plan_schema": "references/html-design.schema.json",
    "asset_manifest": "assets/html-kit/asset-manifest.json",
    "asset_mode": "inline_selected_only",
    "renderers": ["native-svg", "echarts", "mermaid", "semantic-html"],
    "native_svg_fallback_required": true,
    "critical_information_may_require_interaction": false,
    "collapsed_priority_allowed": ["P2"],
    "minimum_body_font_px": 14,
    "minimum_caption_font_px": 12,
    "one_picture_min_width_height_ratio": 1.2,
    "one_picture_max_width_height_ratio": 2.0,
    "visual_spec_required_for_validation": true
  },
  "tldr": {
    "default_title": "TLDR",
    "default_table_headers": ["问题", "结论", "为什么"],
    "english_table_headers": ["Question", "Conclusion", "Why"],
      "opening_unit": {
        "primary_judgment_count": 1,
        "support_lines_min": 1,
        "support_lines_max": 3,
        "allowed_support_roles": ["evidence", "action", "boundary"],
        "fixed_label_prefixes": ["结论", "证据", "行动", "下一步", "边界", "Conclusion", "Evidence", "Action", "Next step", "Boundary"],
        "fixed_label_failure_count": 2
    },
    "questions_min": 3,
    "questions_max": 5
  },
  "trigger": {
    "aliases": [
      "3080-brief",
      "3080 brief",
      "3080skill",
      "读者视角总结",
      "3080总结",
      "3080summary",
      "3080-onepager"
    ],
    "non_trigger_intents": [
      "edit or polish the source in place",
      "generic summary without a 30-second or visual requirement",
      "standalone whiteboard style exploration without a new summary document"
    ]
  },
  "banned_whiteboard_styles": [
    "Grove",
    "Macchiato",
    "Monochrome",
    "Cobalt Bloom",
    "Linen Cut",
    "Raw Grid",
    "Riptide Cobalt",
    "Soft Editorial",
    "BlockFrame",
    "Burst Panel",
    "Crayon Stack",
    "Neo-Grid Bold",
    "Riso Brut"
  ],
  "forbidden_headings": [
    "来源文档",
    "原文链接",
    "Source Document",
    "先回答关键问题",
    "Key Questions First",
    "术语与口径",
    "Glossary",
    "30 秒判断",
    "30秒判断",
    "30 秒读法",
    "30-second read",
    "剩余 20% 信息",
    "Remaining 20%"
  ],
  "forbidden_heading_fragments": [
    "给 Leader",
    "For Leader",
    "For Leaders"
  ],
  "forbidden_meta_statements": [
    "原文正文数据支持这个顺序",
    "原文支持该顺序",
    "the source supports this order"
  ],
  "forbidden_placeholders": [
    "SOURCE_URL",
    "按原文填写",
    "...svg...",
    "实际输出必须插入可编辑白板"
  ],
  "expression_quality": {
    "required_relation_priorities": ["P0", "P1"],
    "claim_strength_order": [
      "unknown",
      "reported",
      "observed",
      "suggestive",
      "supported",
      "demonstrated",
      "causal"
    ],
    "thin_source_guardrail": {
      "source_snapshot_required": true,
      "max_expansion_ratio": 4.0,
      "minimum_output_unit_ceiling": 240,
      "max_body_sections": 2
    },
    "runtime_profiles": {
      "fast": {
        "selection": "explicit_user_request_only",
        "hard_gates": "all",
        "expression_scan": true,
        "review": "self_check_only",
        "visual_blind_replay": "self_check_and_disclose",
        "blind_reader_replay": "skip_and_disclose",
        "audit_sequence_terminal": "after_self_check"
      },
      "standard": {
        "selection": "default",
        "hard_gates": "all",
        "expression_scan": true,
        "review": "three_independent_reviewers",
        "visual_blind_replay": "independent_before_audit",
        "blind_reader_replay": "primary_then_configured_escalation"
      },
      "strict": {
        "selection": "explicit_or_material_resource_policy_causal_risk_rollout",
        "hard_gates": "all",
        "expression_scan": true,
        "relation_replay": "all_non_appendix_p0_p1",
        "review": "three_independent_reviewers",
        "visual_blind_replay": "independent_before_audit",
        "blind_reader_replay": "primary_then_configured_escalation"
      }
    },
    "style_warning_groups": [
      {
        "id": "vague_abstraction_zh",
        "languages": ["zh"],
        "minimum_hits": 2,
        "patterns": ["有价值", "值得关注", "整体有效", "整体不错", "优化提升", "继续观察", "带来提升"],
        "message": "multiple vague value claims appear without source-specific meaning"
      },
      {
        "id": "mechanical_sequence_zh",
        "languages": ["zh"],
        "minimum_hits": 3,
        "patterns": ["首先", "其次", "再次", "最后", "综上所述"],
        "message": "mechanical sequencing may be substituting for a reader-fit reasoning path"
      },
      {
        "id": "binary_reframe_zh",
        "languages": ["zh"],
        "minimum_hits": 2,
        "patterns": ["不是.{0,28}?而是", "并非.{0,28}?而是"],
        "message": "repeated binary reframing may sound formulaic; keep only distinctions that change meaning"
      },
      {
        "id": "inflated_certainty_zh",
        "languages": ["zh"],
        "minimum_hits": 2,
        "patterns": ["彻底解决", "完全证明", "毫无风险", "必然导致", "颠覆性", "革命性"],
        "message": "repeated absolute wording may exceed the source evidence ceiling"
      },
      {
        "id": "vague_abstraction_en",
        "languages": ["en"],
        "minimum_hits": 2,
        "patterns": ["\\bvaluable\\b", "\\bworth noting\\b", "\\bmeaningful improvement\\b", "\\boverall effective\\b", "\\bworth watching\\b"],
        "message": "multiple vague value claims appear without source-specific meaning"
      },
      {
        "id": "mechanical_sequence_en",
        "languages": ["en"],
        "minimum_hits": 3,
        "patterns": ["\\bfirst(?:ly)?\\b", "\\bsecond(?:ly)?\\b", "\\bthird(?:ly)?\\b", "\\bfinally\\b", "\\bin conclusion\\b"],
        "message": "mechanical sequencing may be substituting for a reader-fit reasoning path"
      },
      {
        "id": "binary_reframe_en",
        "languages": ["en"],
        "minimum_hits": 2,
        "patterns": ["\\bnot (?:just|merely).{0,80}?\\bbut\\b", "\\bnot about.{0,80}?\\babout\\b"],
        "message": "repeated binary reframing may sound formulaic; keep only distinctions that change meaning"
      },
      {
        "id": "inflated_certainty_en",
        "languages": ["en"],
        "minimum_hits": 2,
        "patterns": ["\\bfully solved\\b", "\\bproves conclusively\\b", "\\bno risk\\b", "\\binevitably\\b", "\\brevolutionary\\b", "\\bgame-changing\\b"],
        "message": "repeated absolute wording may exceed the source evidence ceiling"
      }
    ]
  },
  "review_roles": {
    "reader": "Reader Comprehension Reviewer",
    "source": "Source Coverage And Grounding Reviewer",
    "visual": "Visualization And Expression Reviewer"
  },
  "visual_blind_replay": {
    "reader_role": "visual_blind",
    "position": "after_render_validation_before_audit",
    "input": "cropped_one_picture_only",
    "forbidden_inputs": [
      "tldr_text",
      "body",
      "source",
      "claim_ledger",
      "visual_spec",
      "html_design",
      "alt_text",
      "expected_answer",
      "coverage_report",
      "reviewer_comments"
    ],
    "required_replay_fields": [
      "main_judgment",
      "supporting_evidence",
      "next_action_or_boundary",
      "reading_path",
      "unresolved_confusion"
    ],
    "failure_restart": "visualize_then_deterministic_gates"
  },
  "blind_reader_replay": {
    "question_count": 3,
    "primary_role": "primary",
    "roles": {
      "primary": "理解业务、产品和常见指标，不了解技术实现，无决策能力。",
      "technical": "具备相关领域的专业知识和通用技术能力，注重底层逻辑和可行性。",
      "decision": "阅读时间有限，不具备项目隐含背景，不希望先阅读实施细节，注重收益和成功的可复制性。"
    },
    "escalation_conditions": [
      "document_addresses_multiple_functions",
      "primary_cannot_replay_p0_core_conclusion",
      "primary_cannot_identify_next_action",
      "primary_cannot_judge_conclusion_value",
      "primary_cannot_judge_conclusion_feasibility",
      "conclusion_affects_resources_risk_or_broad_rollout"
    ]
  }
}
