{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reviewer_role",
    "review_mode",
    "reviewer_run_id",
    "artifact_set_id",
    "review_round",
    "verdict",
    "checks",
    "blocking_issues",
    "unsupported_claims",
    "missing_coverage",
    "required_fixes"
  ],
  "properties": {
    "reviewer_role": {"enum": ["reader", "source", "visual"]},
    "review_mode": {"enum": ["independent", "self_check"]},
    "reviewer_run_id": {"type": "string", "minLength": 1},
    "artifact_set_id": {"type": "string", "minLength": 1},
    "review_round": {"type": "integer", "minimum": 1},
    "verdict": {"enum": ["PASS", "FAIL"]},
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "result", "reason"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "result": {"enum": ["PASS", "FAIL"]},
          "reason": {"type": "string", "minLength": 1}
        }
      }
    },
    "blocking_issues": {"type": "array"},
    "unsupported_claims": {"type": "array"},
    "missing_coverage": {"type": "array"},
    "required_fixes": {"type": "array"}
  }
}
